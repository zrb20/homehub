# HomeHub 环境变量示例 —— 复制为 .env 并填写你的真实值
# 本项目不硬编码任何凭据;下方 <> 内为占位符,请替换为你自己的值

# ---- miloco(小米智能家居本地服务)----
MILOCO_BASE_URL=http://127.0.0.1:1810
MILOCO_TOKEN=<从 miloco-data/config.json 的 server.token 获取>
CAMERA_ID=<小米摄像头设备 ID,可留空>

# ---- 爱快路由(网络设备数据源)----
IKUAI_URL=http://192.168.1.1
IKUAI_USER=admin
IKUAI_PASS=<爱快登录密码>

# ---- 天气(和风为可选第 4 源)----
QWEATHER_HOST=<和风控制台凭据详情里的私有 Host>
QWEATHER_KEY=<和风 API Key>
WEATHER_LAT=39.9042
WEATHER_LON=116.4074
WEATHER_CITY_ID=101010100

# ---- 其他 ----
ZR_DEVICE_INFO=/data/device_info.json
LAYOUT_FILE=/data/layout.json
CARDS_FILE=/data/cards.json
TZ=Asia/Shanghai
